# Copie este arquivo para .env e preencha com seus valores reais
# .env e ignorado pelo git e nao deve ser commitado

# Banco de dados MySQL (com fallback automatico para SQLite local se inacessivel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_aqui
DB_NAME=ortomapas

# Chave JWT HS256: gere pelo menos 32 bytes aleatorios por ambiente
AUTH_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes

# URLs de servicos Docker
WEBODM_URL=http://localhost:8000
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=defina-uma-senha-forte-compartilhada-com-o-geoserver

# API FastAPI
API_HOST=0.0.0.0
API_PORT=8888

# Worker da fila de análises; use 0 para executar somente a API sem processar tarefas.
AGENT_WORKER_ENABLED=1
AGENT_WORKER_POLL_SECONDS=5

# Chave Anthropic somente no .env local (nunca a versione)
ANTHROPIC_API_KEY=<set-in-local-env>

# Provedor temporario do Copiloto: anthropic ou lmstudio. Nunca inclua a chave real no Git.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_OUTPUT_TOKENS=768
LLM_MAX_INPUT_CHARS=20000
LLM_MAX_CALLS_PER_TURN=5

# Grafana (obrigatorio ao subir a stack de observabilidade)
GRAFANA_ADMIN_PASSWORD=gere-uma-senha-forte-aqui
